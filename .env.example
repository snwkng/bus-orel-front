# Адрес бэкенд-API: на него проксируются запросы /api/** (см. routeRules в nuxt.config.ts)
# Бэкенд по умолчанию слушает порт 3000 — при локальном запуске рядом с фронтом
# задайте ему другой PORT (например 4000) и укажите его здесь
BASE_URL=http://localhost:4000

# Публичный URL сайта (canonical, sitemap, robots). Необязательно — дефолт https://bus-orel.ru
# SITE_URL=https://bus-orel.ru
